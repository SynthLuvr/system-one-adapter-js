{
  "name": "system-one-adapter",
  "version": "0.3.0",
  "description": "Drop-in TypeSafeClient replacement backed by LLM APIs",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "==26"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SynthLuvr/system-one-adapter-js.git"
  },
  "keywords": [
    "llm",
    "openai",
    "anthropic",
    "structured-outputs",
    "evaluation",
    "arktype"
  ],
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "build:dist": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm lint && pnpm test && pnpm build:dist",
    "format": "ts-canon format",
    "lint": "ts-canon lint",
    "test": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "arktype": "^2.2.3",
    "openai": "^7.20.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^5.0.0",
    "msw": "^2.15.0",
    "ts-canon": "^0.1.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
